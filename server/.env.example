# ==============================================================================
# VolunteerHub Server Configuration Template
# ==============================================================================
# Copy this file to .env and provide real secret values.
# NEVER commit .env to version control.

# Application Environment ('development', 'test', 'production')
NODE_ENV=production

# HTTP Port for Node Express API server
PORT=5000

# MongoDB Connection String (MongoDB Atlas replica set in production)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/volunteerhub?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://volunteer_admin:secure_password@cluster0.mongodb.net/volunteerhub?retryWrites=true&w=majority

# JWT Access Token Secret (At least 32 random characters)
JWT_SECRET=replace_with_strong_production_jwt_access_secret_32_chars

# JWT Refresh Token Secret (Stored in httpOnly cookie; distinct from JWT_SECRET)
JWT_REFRESH_SECRET=replace_with_strong_production_jwt_refresh_secret_32_chars

# Access token expiry duration
JWT_EXPIRES_IN=1h

# AES-256-GCM 256-bit Encryption Key for sensitive financial data (UPI IDs)
# MUST be a 64-character hexadecimal string (32 bytes).
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Client Origin Allowlist for CORS (comma-separated if multiple domains)
# Example: https://volunteerhub.vercel.app,https://admin.volunteerhub.vercel.app
CLIENT_ORIGIN=https://volunteerhub.vercel.app

# Structured Logging Level ('fatal', 'error', 'warn', 'info', 'debug')
LOG_LEVEL=info

# Initial Admin Seed Password (optional; only needed if running seed in production)
ADMIN_INITIAL_PASSWORD=replace_with_strong_initial_admin_password
